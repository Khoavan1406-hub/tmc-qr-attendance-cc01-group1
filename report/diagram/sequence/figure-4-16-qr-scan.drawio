xGeometry x="859.0" y="856.36" width="20" height="20" as="geometry"/></mxCell><mxCell id="c59" value="Timely: passage + attendance +&lt;br&gt;audit + outbox, one transaction.&lt;br&gt;Late: store for review; no attendance." style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0.9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=15;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="69.0" y="844.84" width="274.0" height="68.56" as="geometry"/></mxCell><mxCell id="c60" value="LANE_CLEAR" style="text;align=center;verticalAlign=bottom;fontSize=16;spacing=0;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="221.0" y="936.36" width="729.0" height="19.52" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;9&lt;/b&gt;" style="ellipse;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.1;fontSize=12;spacing=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="859.0" y="946.88" width="20" height="20" as="geometry"/></mxCell><mxCell id="c63" value="Persist CLOSE_SENT and&lt;br&gt;closeCommandId; send once.&lt;br&gt;Stored CLOSED releases the lane." style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0.9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=15;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="69.0" y="935.36" width="274.0" height="68.56" as="geometry"/></mxCell><mxCell id="c64" value="closeGate(closeCommandId, laneId)" style="text;align=center;verticalAlign=bottom;fontSize=16;spacing=0;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="221.0" y="965.88" width="729.0" height="19.52" as="geometry"/></mxCell><mxCell id="c66" value="CLOSED" style="text;align=center;verticalAlign=bottom;fontSize=16;spacing=0;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontFamil